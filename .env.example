# Скопіюйте у файл .env і заповніть: cp .env.example .env  (файл .env не потрапляє в git).
# Згенерувати випадковий токен: openssl rand -hex 24

# Токен адміністратора (зміна налаштувань цін, курсу EUR тощо). Обов’язковий.
KP_ADMIN_TOKEN=

# Токен доступу для менеджерів. Якщо задано, без нього API не працює (крім /api/health).
# Порожньо — доступ без токена (лише для закритої мережі офісу).
KP_ACCESS_TOKEN=

# Порт на сервері. Якщо перед застосунком стоїть reverse proxy на цьому ж сервері: 127.0.0.1:8080
KP_HOST_PORT=8080
